// Extension-Local.xcconfig — local VoiceActivity extension overrides.
// The bundle ID must stay prefixed by App-Local.xcconfig's, and the URL
// scheme must match App-Local.xcconfig's exactly or the island deep-links
// into the production app when it happens to be installed. The App Group
// must match App-Local.xcconfig's character for character too: a container
// is shared only between bundles naming the identical group.

#include "Extension-Base.xcconfig"

APP_GROUP_ID = group.ai.mycadet.ios.local
BUNDLE_DISPLAY_NAME = Cadet Local
BUNDLE_URL_SCHEME = cadet-local

// The ground the app's mark is drawn on, which must equal the
// `fill-specializations` solid in `App/AppIcon-Local.icon/icon.json`: the widget
// draws the containing app's icon, and this build's icon is not the production
// one.
APP_ICON_GROUND = display-p3:0.27576,0.59870,0.54572,1.00000
PRODUCT_BUNDLE_IDENTIFIER = ai.mycadet.ios.local.VoiceActivity

// Exact portal profile name; must equal release-ios.yaml's `ext_profile_name`.
PROVISIONING_PROFILE_SPECIFIER_Manual = Cadet Assistant iOS Local VoiceActivity Distribution
