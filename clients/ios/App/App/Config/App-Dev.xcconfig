// App-Dev.xcconfig — dev target overrides.

#include "Base.xcconfig"

// Alternate app icons compiled from App/App/AvatarIcons.xcassets.
#include "AvatarIcons.xcconfig"

APP_GROUP_ID = group.ai.mycadet.ios.dev
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-Dev
ASSOCIATED_DOMAIN = dev.cloud.mycadet.ai
BUNDLE_DISPLAY_NAME = Cadet Dev
BUNDLE_URL_SCHEME = mycadet-dev
CODE_SIGN_ENTITLEMENTS = App/App-Dev.entitlements
PRODUCT_BUNDLE_IDENTIFIER = ai.mycadet.ios.dev

// Exact portal profile name; must equal release-ios.yaml's `profile_name`.
PROVISIONING_PROFILE_SPECIFIER_Manual = Cadet Assistant iOS Dev Distribution
