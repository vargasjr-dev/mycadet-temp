// Share-Staging.xcconfig - staging Share extension overrides.
// The bundle ID must stay prefixed by App-Staging.xcconfig's, and the
// URL scheme and App Group must match that app's values exactly.

#include "Share-Base.xcconfig"

APP_GROUP_ID = group.ai.mycadet.ios.staging
BUNDLE_DISPLAY_NAME = Cadet Staging
BUNDLE_URL_SCHEME = mycadet-staging
PRODUCT_BUNDLE_IDENTIFIER = ai.mycadet.ios.staging.Share

PROVISIONING_PROFILE_SPECIFIER_Manual = Cadet Assistant iOS Staging Share Distribution
