// App.xcconfig — production target overrides.

#include "Base.xcconfig"

// Alternate app icons compiled from App/App/AvatarIcons.xcassets.
#include "AvatarIcons.xcconfig"

APP_GROUP_ID = group.ai.mycadet.ios
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSOCIATED_DOMAIN = mycadet.ai
BUNDLE_DISPLAY_NAME = Cadet
BUNDLE_URL_SCHEME = mycadet
PRODUCT_BUNDLE_IDENTIFIER = ai.mycadet.ios

// Exact portal profile name; must equal release-ios.yaml's `profile_name`.
PROVISIONING_PROFILE_SPECIFIER_Manual = Cadet Assistant iOS Distribution
