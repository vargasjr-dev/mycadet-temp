// Share-Dev.xcconfig - dev Share extension overrides.
// The bundle ID must stay prefixed by App-Dev.xcconfig's, and the URL
// scheme and App Group must match that app's values exactly.

#include "Share-Base.xcconfig"

APP_GROUP_ID = group.ai.mycadet.ios.dev
BUNDLE_DISPLAY_NAME = Cadet Dev
BUNDLE_URL_SCHEME = mycadet-dev
PRODUCT_BUNDLE_IDENTIFIER = ai.mycadet.ios.dev.Share

PROVISIONING_PROFILE_SPECIFIER_Manual = Cadet Assistant iOS Dev Share Distribution
