// Share-Local.xcconfig - local Share extension overrides.
// The bundle ID must stay prefixed by App-Local.xcconfig's, and the URL
// scheme and App Group must match that app's values exactly.

#include "Share-Base.xcconfig"

APP_GROUP_ID = group.ai.mycadet.ios.local
BUNDLE_DISPLAY_NAME = Cadet Local
BUNDLE_URL_SCHEME = cadet-local
PRODUCT_BUNDLE_IDENTIFIER = ai.mycadet.ios.local.Share

PROVISIONING_PROFILE_SPECIFIER_Manual = Cadet Assistant iOS Local Share Distribution
