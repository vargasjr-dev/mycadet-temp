{
  "name": "@mycadet/android",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vargasjr-dev/mycadet-temp.git"
  },
  "type": "module",
  "description": "Cadet Android Capacitor shell — native Gradle project plus the plugin set its sync wires",
  "scripts": {
    "dev": "bun run scripts/run-android.ts",
    "build": "(cd ../app && bun run build:capacitor) && bunx --bun cap sync android"
  },
  "devDependencies": {
    "@capacitor-community/camera-preview": "8.0.1",
    "@capacitor/android": "8.3.4",
    "@capacitor/app": "8.1.0",
    "@capacitor/browser": "8.0.3",
    "@capacitor/cli": "8.3.4",
    "@capacitor/core": "8.3.4",
    "@capacitor/file-viewer": "2.0.1",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/haptics": "8.0.0",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/local-notifications": "8.2.0",
    "@capacitor/network": "8.0.0",
    "@capacitor/push-notifications": "8.0.3",
    "@capacitor/share": "8.0.1",
    "@capawesome/capacitor-file-picker": "8.0.4",
    "@mycadet/app": "workspace:*",
    "@mycadet/environments": "workspace:*",
    "capacitor-plugin-safe-area": "5.0.0",
    "typescript": "5.9.3"
  }
}
