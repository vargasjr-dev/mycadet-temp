{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowJs": false,
    "isolatedModules": true,
    "types": ["bun"],
    "paths": {
      "@app/*": ["./src/*"],
      "@web/*": ["../web/src/*"],
      "@/*": ["../web/src/*"],
      "@design/*": ["../../packages/design-library/src/*"]
    }
  },
  "include": ["src", "../web/src", "capacitor.config.base.ts"]
}
