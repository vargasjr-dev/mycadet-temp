{
  "name": "@mycadet/app",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vargasjr-dev/mycadet-temp.git"
  },
  "type": "module",
  "description": "Cadet account/client shell — portable package plus a standalone bundle for self-hosted edges",
  "license": "MIT",
  "files": [
    "dist/package",
    "dist/standalone"
  ],
  "exports": {
    ".": {
      "types": "./dist/package/types/index.d.ts",
      "default": "./dist/package/index.js"
    },
    "./contracts": {
      "types": "./dist/package/types/contracts.d.ts",
      "default": "./dist/package/contracts.js"
    },
    "./capacitor.config.base": "./capacitor.config.base.ts"
  },
  "dependencies": {
    "@capacitor/app": "8.1.0",
    "@capacitor/browser": "8.0.3",
    "@capacitor/core": "8.3.4",
    "@mycadet/assistant-api": "workspace:*",
    "@mycadet/avatar-catalog": "workspace:*",
    "@mycadet/avatar-manifest": "workspace:*",
    "@mycadet/design-library": "workspace:*",
    "@mycadet/environments": "workspace:*",
    "@mycadet/ipc-contract": "workspace:*",
    "@mycadet/service-contracts": "workspace:*",
    "@tanstack/react-query": "5.90.21",
    "i18next": "26.3.6",
    "i18next-icu": "2.4.4",
    "lucide-react": "1.16.0",
    "motion": "12.39.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "17.0.11",
    "react-router": "7.15.0",
    "zod": "4.3.6",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@capacitor-community/camera-preview": "8.0.1",
    "@capacitor/cli": "8.3.4",
    "@capacitor/file-viewer": "2.0.1",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/haptics": "8.0.0",
    "@capacitor/ios": "8.3.4",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/local-notifications": "8.2.0",
    "@capacitor/network": "8.0.0",
    "@capacitor/push-notifications": "8.0.3",
    "@capacitor/share": "8.0.1",
    "@capawesome/capacitor-file-picker": "8.0.4",
    "@happy-dom/global-registrator": "20.10.2",
    "@hey-api/openapi-ts": "0.97.1",
    "@mycadet/local-mode": "workspace:*",
    "@mycadet/shared": "workspace:*",
    "@tailwindcss/vite": "4.1.8",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "capacitor-plugin-safe-area": "5.0.0",
    "tailwindcss": "4.1.8",
    "typescript": "5.9.3",
    "vite": "8.0.11"
  },
  "scripts": {
    "predev": "bun run build",
    "dev": "bun --bun vite",
    "build": "bun scripts/build.ts",
    "build:capacitor": "bun scripts/build-capacitor.ts",
    "preview": "bun --bun vite preview",
    "test": "bun test",
    "test:ci": "bun scripts/run-tests.ts",
    "typecheck": "bunx tsc --noEmit",
    "openapi-ts": "bun run ../web/scripts/transform-daemon-spec.ts && openapi-ts",
    "postinstall": "bun run openapi-ts"
  }
}
