{
  "name": "@mycadet/app",
  "version": "0.0.0",
  "type": "module",
  "description": "Cadet account/client shell — portable package plus a standalone bundle for self-hosted edges",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/package/types/index.d.ts",
      "default": "./dist/package/index.js"
    },
    "./contracts": {
      "types": "./dist/package/types/contracts.d.ts",
      "default": "./dist/package/contracts.js"
    }
  },
  "dependencies": {
    "@capacitor/app": "8.1.0",
    "@capacitor/browser": "8.0.3",
    "@capacitor/core": "8.3.4",
    "@mycadet/design-library": "workspace:*",
    "@mycadet/ipc-contract": "workspace:*",
    "i18next": "26.3.6",
    "i18next-icu": "2.4.4",
    "lucide-react": "1.16.0",
    "motion": "12.39.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "17.0.11",
    "react-router": "7.15.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.10.2",
    "@mycadet/local-mode": "workspace:*",
    "@mycadet/shared": "workspace:*",
    "@tailwindcss/vite": "4.1.8",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "tailwindcss": "4.1.8",
    "typescript": "5.9.3",
    "vite": "8.0.11"
  },
  "scripts": {
    "predev": "bun run build",
    "dev": "bun --bun vite",
    "build": "bun scripts/build.ts",
    "preview": "bun --bun vite preview",
    "test": "bun test",
    "test:ci": "bun scripts/run-tests.ts",
    "typecheck": "bunx tsc --noEmit"
  }
}
