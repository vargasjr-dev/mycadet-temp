  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "incremental": false,
    "rootDir": "./src",
    "outDir": "./dist/package/types"
  },
  "include": [
    "src/index.ts",
    "src/contracts.ts",
    "src/i18n/i18next.d.ts"
  ],
  "exclude": [
