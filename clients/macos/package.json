{
  "name": "@mycadet/macos",
  "version": "0.0.1",
  "private": true,
  "description": "Electron wrapper for the Cadet macOS app.",
  "main": "out/main/index.js",
  "scripts": {
    "setup": "node node_modules/electron/install.js && bash scripts/build-mac-helper.sh && (bash scripts/build-notifier.sh || echo 'notifier unavailable; notifications fall back to Electron')",
    "dev": "bun run install:all && bun scripts/dev.ts",
    "install:all": "bun install && bun run setup",
    "prepare:electron-dev": "bun scripts/prepare-electron-dev-app.ts",
    "build": "electron-vite build",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "test:ci": "bun run --filter=@mycadet/electron-desktop test && bun scripts/run-tests.ts",
    "build:fetch-bun": "bash scripts/fetch-bun.sh",
    "build:app": "cd ../app && bun install && bun run build && cd ../macos && mkdir -p resources && rm -rf resources/app-dist && cp -R ../app/dist/standalone resources/app-dist",
    "pack": "bash scripts/pack.sh",
    "pack:debug": "CADET_ENABLE_CHROME_DEVTOOLS=true bash scripts/pack.sh"
  },
  "devDependencies": {
    "@mycadet/shared": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "22.10.5",
    "app-builder-lib": "26.8.1",
    "builder-util": "26.8.1",
    "electron": "42.2.0",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "node-addon-api": "8.9.0",
    "node-gyp": "12.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.3"
  },
  "dependencies": {
    "@mycadet/electron-desktop": "workspace:*",
    "@mycadet/electron-utils": "workspace:*",
    "@mycadet/environments": "workspace:*",
    "@mycadet/ipc-contract": "workspace:*",
    "@mycadet/local-mode": "workspace:*",
    "@mycadet/native-sidecar": "workspace:*",
    "electron-log": "5.4.4",
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9",
    "zod": "4.3.6"
  }
}
