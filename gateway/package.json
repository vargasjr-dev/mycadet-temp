{
  "name": "@mycadet/gateway",
  "version": "0.12.6",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./twilio/verify": "./src/twilio/verify.ts",
    "./cli": "./src/cli/index.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "gateway": "./src/cli/index.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "schema": "bun run src/cli/schema.ts",
    "generate:openapi": "bun run scripts/generate-openapi.ts",
    "db:generate": "drizzle-kit generate --dialect sqlite --schema src/db/schema.ts --out src/db/migrations",
    "start": "bun run src/index.ts",
    "test": "bun run scripts/run-tests.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "lint:unused": "knip --include files,dependencies,unlisted",
    "typecheck": "bunx tsc --noEmit",
    "prebuild": "cd .. && bun run meta/sync-bundled-copies.ts",
    "postinstall": "cd .. && (git config core.hooksPath || git config core.hooksPath .githooks 2>/dev/null || true) && ([ -f meta/sync-bundled-copies.ts ] && bun run meta/sync-bundled-copies.ts 2>/dev/null || true)"
  },
  "dependencies": {
    "@mycadet/assistant-client": "workspace:*",
    "@mycadet/ces-client": "workspace:*",
    "@mycadet/environments": "workspace:*",
    "@mycadet/gateway-client": "workspace:*",
    "@mycadet/ipc-server-utils": "workspace:*",
    "@mycadet/service-contracts": "workspace:*",
    "@mycadet/slack-text": "workspace:*",
    "@mycadet/twilio-client": "workspace:*",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "file-type": "21.3.0",
    "pino": "9.14.0",
    "pino-pretty": "13.1.3",
    "tree-sitter-bash": "0.25.1",
    "web-tree-sitter": "0.26.5",
    "zod": "4.3.6",
    "zod-openapi": "5.4.6"
  },
  "bundledDependencies": [
    "@mycadet/assistant-client",
    "@mycadet/ces-client",
    "@mycadet/environments",
    "@mycadet/gateway-client",
    "@mycadet/ipc-server-utils",
    "@mycadet/service-contracts",
    "@mycadet/slack-text",
    "@mycadet/twilio-client"
  ],
  "devDependencies": {
    "@grammyjs/types": "4.0.0",
    "@mycadet/shared": "workspace:*",
    "@slack/types": "2.22.0",
    "@types/bun": "1.3.9",
    "discord-api-types": "0.38.53",
    "eslint": "10.0.0",
    "fast-check": "4.7.0",
    "knip": "5.83.1",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.0"
  }
}
