{
  "version": 2,
  "providers": [
    {
      "id": "inference-provider-native",
      "displayName": "Provider Native"
    },
    {
      "id": "perplexity",
      "displayName": "Perplexity",
      "apiKeyPrefix": "pplx-...",
      "envVar": "PERPLEXITY_API_KEY",
      "secretKey": "perplexity",
      "fallbackOrder": 1,
      "privacyPolicyUrl": "https://www.perplexity.ai/hub/legal/privacy-policy"
    },
    {
      "id": "brave",
      "displayName": "Brave",
      "displayNameLong": "Brave Search",
      "apiKeyPrefix": "BSA...",
      "envVar": "BRAVE_API_KEY",
      "secretKey": "brave",
      "fallbackOrder": 2,
      "privacyPolicyUrl": "https://search.brave.com/help/privacy-policy"
    },
    {
      "id": "tavily",
      "displayName": "Tavily",
      "apiKeyPrefix": "tvly-...",
      "envVar": "TAVILY_API_KEY",
      "secretKey": "tavily",
      "fallbackOrder": 3,
      "privacyPolicyUrl": "https://tavily.com/privacy"
    },
    {
      "id": "firecrawl",
      "displayName": "Firecrawl",
      "apiKeyPrefix": "fc-...",
      "envVar": "FIRECRAWL_API_KEY",
      "secretKey": "firecrawl",
      "fallbackOrder": 4,
      "privacyPolicyUrl": "https://www.firecrawl.dev/privacy-policy"
    },
    {
      "id": "keenable",
      "displayName": "Keenable",
      "apiKeyPrefix": "keen_... (optional)",
      "envVar": "KEENABLE_API_KEY",
      "secretKey": "keenable",
      "fallbackOrder": 5,
      "privacyPolicyUrl": "https://keenable.ai/privacy"
    },
    {
      "id": "fastcrw",
      "displayName": "fastCRW",
      "apiKeyPrefix": "crw_live_...",
      "envVar": "FASTCRW_API_KEY",
      "secretKey": "fastcrw",
      "fallbackOrder": 6,
      "privacyPolicyUrl": "https://fastcrw.com/privacy",
      "supportsApiBase": true,
      "defaultApiBase": "https://api.fastcrw.com"
    },
    {
      "id": "searxng",
      "displayName": "SearXNG",
      "apiKeyPrefix": "token (optional)",
      "envVar": "SEARXNG_API_KEY",
      "secretKey": "searxng",
      "fallbackOrder": 7,
      "privacyPolicyUrl": "https://docs.searxng.org/own-instance.html",
      "supportsApiBase": true
    },
    {
      "id": "tinyfish",
      "displayName": "TinyFish",
      "apiKeyPrefix": "TinyFish API key...",
      "envVar": "TINYFISH_API_KEY",
      "secretKey": "tinyfish",
      "fallbackOrder": 8,
      "privacyPolicyUrl": "https://www.tinyfish.ai/privacy-policy",
      "supportsApiBase": true,
      "defaultApiBase": "https://api.search.tinyfish.ai"
    },
    {
      "id": "exa",
      "displayName": "Exa",
      "apiKeyPrefix": "Exa API key...",
      "envVar": "EXA_API_KEY",
      "secretKey": "exa",
      "fallbackOrder": 9,
      "privacyPolicyUrl": "https://exa.ai/privacy-policy"
    },
    {
      "id": "serply",
      "displayName": "Serply",
      "apiKeyPrefix": "Serply API key...",
      "envVar": "SERPLY_API_KEY",
      "secretKey": "serply",
      "fallbackOrder": 10,
      "privacyPolicyUrl": "https://serply.io/privacy"
    }
  ]
}
