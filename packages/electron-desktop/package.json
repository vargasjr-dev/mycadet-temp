    "jszip": "3.10.1"
  },
  "peerDependencies": {
    "electron-log": ">=5.4.4",
    "electron-store": ">=11.0.2",
    "electron-updater": ">=6.8.9",
    "electron": ">=42.2.0",
    "zod": ">=4.0.0"
  },
  "devDependencies": {
    "prettier": "3.8.1",
    "@mycadet/shared": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "22.10.5",
    "electron": "42.2.0",
    "electron-log": "5.4.4",
    "electron-store": "11.0.2",
    "eslint": "10.2.0",
    "typescript": "5.9.3",
    "zod": "4.3.6"
  }
