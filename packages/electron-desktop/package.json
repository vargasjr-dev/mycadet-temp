{
  "name": "@mycadet/electron-desktop",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app-name": "./src/app-name.ts",
    "./avatar": "./src/avatar.ts",
    "./avatar-image": "./src/avatar-image.ts",
    "./capability-registry": "./src/capability-registry.ts",
    "./file-open-preload": "./src/file-open-preload.ts",
    "./ipc": "./src/ipc.ts",
    "./preload": "./src/preload.ts",
    "./preload/compose": "./src/preload/compose.ts",
    "./preload/features/*": "./src/preload/features/*.ts",
    "./session-token-store": "./src/session-token-store.ts",
    "./settings": "./src/settings.ts",
    "./status": "./src/status.ts",
    "./test-setup": "./test-setup.ts",
    "./windows": "./src/windows.ts"
  },
  "scripts": {
    "lint": "prettier --check src scripts test-setup.ts && eslint . --max-warnings 397",
