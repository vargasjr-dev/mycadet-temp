{
  "name": "@mycadet/assistant",
  "version": "0.12.9",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "assistant": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "daemon:restart:http": "RUNTIME_HTTP_PORT=7821 bun run src/index.ts daemon restart",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "generate:openapi": "bun run scripts/generate-openapi.ts",
    "sync:llm-catalog": "bun run scripts/sync-llm-catalog.ts",
    "sync:web-search-catalog": "bun run scripts/sync-web-search-catalog.ts",
    "probe:skill-retrieval": "bun run scripts/probe-skill-retrieval.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "bun run lint:skills && bun run lint:openapi && eslint --max-warnings 2842",
    "lint:unused": "knip --include files,dependencies,unlisted",
    "lint:circular": "bun run scripts/check-circular-deps.ts",
    "lint:unused:production": "knip --production --include exports",
    "typecheck": "bunx tsgo --noEmit",
    "test": "bun run scripts/run-tests.ts",
    "test:coverage": "COVERAGE=true bun run scripts/run-tests.ts",
    "test:stable": "EXCLUDE_EXPERIMENTAL=true bun run scripts/run-tests.ts",
    "test:bench": "find src -type f -name '*.benchmark.test.ts' -print0 | xargs -0 -P 1 -I {} bun test {}",
    "test:filesystem-tools": "bash scripts/test-filesystem-tools.sh",
    "postinstall": "bun run scripts/postinstall.ts",
    "lint:skills": "bun ../scripts/skills/lint-skill-spec.mjs --dir src/config/bundled-skills --allow-tools-json",
    "lint:openapi": "bun run generate:openapi -- --check"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.25.0",
    "@anthropic-ai/sdk": "0.78.0",
    "@google/genai": "1.45.0",
    "@jitl/quickjs-singlefile-mjs-release-asyncify": "0.32.0",
    "@modelcontextprotocol/sdk": "1.27.1",
    "@qdrant/js-client-rest": "1.17.0",
    "@resvg/resvg-js": "2.6.2",
    "@slack/types": "2.22.0",
    "@mycadet/app-icons": "workspace:*",
    "@mycadet/avatar-catalog": "workspace:*",
    "@mycadet/avatar-manifest": "workspace:*",
    "@mycadet/ces-client": "workspace:*",
    "@mycadet/credential-storage": "workspace:*",
    "@mycadet/egress-proxy": "workspace:*",
    "@mycadet/environments": "workspace:*",
    "@mycadet/gateway-client": "workspace:*",
    "@mycadet/ipc-server-utils": "workspace:*",
    "@mycadet/service-contracts": "workspace:*",
    "@mycadet/slack-text": "workspace:*",
    "@mycadet/twilio-client": "workspace:*",
    "@xmldom/xmldom": "0.9.12",
    "commander": "13.1.0",
    "croner": "10.0.1",
    "diff": "8.0.4",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "hast-util-to-html": "9.0.5",
    "ignore": "7.0.9",
    "jszip": "3.10.1",
    "marked": "18.0.0",
    "mdast-util-to-hast": "13.2.1",
    "minimatch": "10.2.4",
    "openai": "6.29.0",
    "pino": "9.14.0",
    "pino-pretty": "13.1.3",
    "playwright": "1.58.2",
    "quickjs-emscripten": "0.32.0",
    "re2js": "2.8.3",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "rrule": "2.8.1",
    "semver": "7.8.0",
    "sharp": "0.35.4",
    "stemmer": "2.0.1",
    "tldts": "7.0.25",
    "unified": "11.0.5",
    "uuid": "11.1.0",
    "yaml": "2.8.2",
    "zod": "4.3.6",
    "zod-openapi": "5.4.6"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "bundledDependencies": [
    "@mycadet/app-icons",
    "@mycadet/avatar-catalog",
    "@mycadet/avatar-manifest",
    "@mycadet/ces-client",
    "@mycadet/credential-storage",
    "@mycadet/service-contracts",
    "@mycadet/egress-proxy",
    "@mycadet/environments",
    "@mycadet/gateway-client",
    "@mycadet/ipc-server-utils",
    "@mycadet/slack-text",
    "@mycadet/twilio-client"
  ],
  "optionalDependencies": {
    "@resvg/resvg-js-darwin-arm64": "2.6.2",
    "@resvg/resvg-js-darwin-x64": "2.6.2"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.58.8",
    "@mycadet/shared": "workspace:*",
    "@types/bun": "1.3.10",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "25.5.0",
    "@types/semver": "7.5.8",
    "@types/uuid": "10.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260624.1",
    "ajv": "8.18.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.0.3",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "fast-check": "4.6.0",
    "knip": "5.86.0",
    "madge": "8.0.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0"
  }
}
