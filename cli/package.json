{
  "name": "@mycadet/cli",
  "version": "0.12.9",
  "description": "CLI tools for mycadet",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./src/components/DefaultMainScreen": "./src/components/DefaultMainScreen.tsx",
    "./src/lib/constants": "./src/lib/constants.ts",
    "./src/lib/hatch-local": "./src/lib/hatch-local.ts",
    "./src/lib/retire-local": "./src/lib/retire-local.ts",
    "./src/lib/guardian-token": "./src/lib/guardian-token.ts",
    "./src/lib/lifecycle-reporter": "./src/lib/lifecycle-reporter.ts",
    "./src/commands/*": "./src/commands/*.ts"
  },
  "bin": {
    "cadet": "./src/index.ts"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 323",
    "lint:unused": "knip --include files,dependencies,unlisted",
    "compile:check": "bun build --compile src/index.ts --outfile /dev/null",
    "test": "bun run scripts/run-tests.ts",
    "typecheck": "bunx tsgo --noEmit"
  },
  "author": "Cadet AI",
  "license": "MIT",
  "dependencies": {
    "@mycadet/assistant-api": "workspace:*",
    "@mycadet/avatar-manifest": "workspace:*",
    "@mycadet/environments": "workspace:*",
    "@mycadet/ipc-server-utils": "workspace:*",
    "@mycadet/local-mode": "workspace:*",
    "@mycadet/service-contracts": "workspace:*",
    "chalk": "5.6.2",
    "ink": "6.8.0",
    "nanoid": "5.1.7",
    "qrcode-terminal": "0.12.0",
    "react": "19.2.6",
    "react-devtools-core": "7.0.1",
    "yaml": "2.8.2",
    "zod": "4.3.6",
    "tar": "7.5.22"
  },
  "bundledDependencies": [
    "@mycadet/assistant-api",
    "@mycadet/avatar-manifest",
    "@mycadet/environments",
    "@mycadet/ipc-server-utils",
    "@mycadet/local-mode",
    "@mycadet/service-contracts"
  ],
  "devDependencies": {
    "@mycadet/shared": "workspace:*",
    "@types/bun": "1.3.11",
    "@types/qrcode-terminal": "0.12.2",
    "@types/react": "19.2.14",
    "@typescript/native-preview": "7.0.0-dev.20260624.1",
    "eslint": "10.1.0",
    "knip": "5.88.1",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.0"
  }
}
